{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions every platform needs. updater:default is deliberately NOT here — it is granted only in desktop.json, because Google Play forbids an app that downloads and installs its own updates, and a capability without a `platforms` field applies to Android too. The frontend already refuses to check for updates on mobile; this is the second lock, not the first.",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$APPCACHE/**" }
      ]
    },
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-create",
    "core:window:allow-show",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "store:default",
    "deep-link:default",
    "os:default",
    "log:default",
    "opener:allow-open-url",
    "notification:default",
    "process:default"
  ]
}