(version 1)
(deny default)
(import "dyld-support.sb")
(allow process-exec*)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow sysctl-read)
(allow file-read* file-test-existence file-map-executable
  (subpath "/bin") (subpath "/sbin") (subpath "/System")
  (subpath "/usr/bin") (subpath "/usr/lib") (subpath "/usr/libexec") (subpath "/usr/sbin") (subpath "/usr/share")
  (subpath (param "TOOLS")))
(allow file-read* file-test-existence
  (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/random") (literal "/dev/zero"))
(allow file-read* file-test-existence file-write* file-map-executable (subpath (param "WS")))
(deny file-lock)
(allow file-lock (subpath (param "WS")))
(allow file-write-data (literal "/dev/null") (literal "/dev/zero"))
(allow file-ioctl (literal "/dev/null"))
