(version 1)
(deny default)
(import "dyld-support.sb")
(allow process-exec*)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow sysctl-read)
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.DirectoryService.libinfo_v1"))
(allow file-read* file-test-existence file-map-executable
  (subpath "/bin") (subpath "/sbin") (subpath "/System")
  (subpath "/usr/bin") (subpath "/usr/lib") (subpath "/usr/libexec") (subpath "/usr/sbin") (subpath "/usr/share")
  (subpath "/Library/Developer/CommandLineTools")
  (subpath (string-append (param "HB") "/bin"))  (subpath (string-append (param "HB") "/lib"))
  (subpath (string-append (param "HB") "/opt"))  (subpath (string-append (param "HB") "/Cellar"))
  (subpath (string-append (param "HB") "/share")) (subpath (string-append (param "HB") "/Frameworks"))
  (subpath (param "TOOLS")))
(allow file-read* file-test-existence
  (subpath "/private/var/db/timezone") (subpath "/private/var/select")
  (literal "/private/var/db/xcode_select_link")
  (subpath "/private/etc/ssl") (literal "/private/etc/passwd") (literal "/private/etc/group")
  (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/random") (literal "/dev/zero"))
(allow file-read* file-test-existence file-write* (subpath (param "WS")))
(deny file-lock)
(allow file-lock (subpath (param "WS")))
(allow file-write-data (literal "/dev/null") (literal "/dev/zero"))
(allow file-ioctl (literal "/dev/null"))
