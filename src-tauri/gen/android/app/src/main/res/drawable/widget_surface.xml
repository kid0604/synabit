<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's own surface. Rounded to read as a field rather than a tile:
  the whole point is that it looks like somewhere you can type.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_border" />
</shape>
